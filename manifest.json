{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Markloupe",
  "version": "1.8.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Markloupe",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.md?*",
        "file:///*.markdown",
        "file:///*.markdown?*",
        "file:///*.mkd",
        "file:///*.mkd?*",
        "file:///*.mdx",
        "file:///*.mdx?*",
        "file:///*.MD",
        "file:///*.MD?*",
        "file:///*.Markdown",
        "file:///*.Markdown?*",
        "file:///*.MARKDOWN",
        "file:///*.MARKDOWN?*",
        "file:///*.MKD",
        "file:///*.MKD?*",
        "file:///*.MDX",
        "file:///*.MDX?*"
      ],
      "js": [
        "src/content/early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "file:///*.md",
        "file:///*.md?*",
        "file:///*.markdown",
        "file:///*.markdown?*",
        "file:///*.mkd",
        "file:///*.mkd?*",
        "file:///*.mdx",
        "file:///*.mdx?*",
        "file:///*.MD",
        "file:///*.MD?*",
        "file:///*.Markdown",
        "file:///*.Markdown?*",
        "file:///*.MARKDOWN",
        "file:///*.MARKDOWN?*",
        "file:///*.MKD",
        "file:///*.MKD?*",
        "file:///*.MDX",
        "file:///*.MDX?*"
      ],
      "js": [
        "vendor/markdown-it.min.js",
        "vendor/markdown-it-footnote.min.js",
        "vendor/markdown-it-emoji.min.js",
        "vendor/markdown-it-container.min.js",
        "vendor/markdown-it-deflist.min.js",
        "vendor/highlight.min.js",
        "src/shared/settings.js",
        "src/shared/i18n.js",
        "src/shared/hash.js",
        "src/shared/lines.js",
        "src/content/util.js",
        "src/content/icons.js",
        "src/content/menu.js",
        "src/content/sanitize.js",
        "src/content/markdown.js",
        "src/content/fonts.js",
        "src/content/enhance.js",
        "src/content/mermaid.js",
        "src/content/math.js",
        "src/content/export.js",
        "src/content/table.js",
        "src/content/files.js",
        "src/content/source.js",
        "src/content/toc.js",
        "src/content/main.js"
      ],
      "css": [
        "src/shared/tokens.css",
        "src/content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-toc": {
      "description": "__MSG_cmdToggleToc__",
      "suggested_key": {
        "default": "Alt+Shift+B"
      }
    },
    "cycle-theme": {
      "description": "__MSG_cmdCycleTheme__",
      "suggested_key": {
        "default": "Alt+Shift+D"
      }
    },
    "cycle-width": {
      "description": "__MSG_cmdCycleWidth__",
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    },
    "toggle-raw": {
      "description": "__MSG_cmdToggleRaw__",
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/mermaid/*",
        "vendor/katex/*",
        "vendor/katex/fonts/*"
      ],
      "matches": [
        "file:///*",
        "*://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "version_name": "1.8.0"
}
